# Copy this file to .env and fill in real values.
# .env must NEVER be committed to version control.

FLASK_ENV=production
SECRET_KEY=replace-with-a-long-random-value

# Database (PostgreSQL)
DATABASE_URL=postgresql://boutique_app_user:replace-me@localhost:5432/boutique_db

# --- Admin console key ---
# Server-side ONLY. Never send this to the browser, never embed it in any
# frontend JS/HTML/template. It authenticates server-to-server / internal
# admin-tooling calls only. The human admin dashboard uses normal
# session + role-based login instead of this key.
ADMIN_API_KEY=replace-with-a-long-random-value

# --- Public key ---
# Safe to expose to the frontend (e.g. for read-only catalog calls from JS).
# Must never grant write access or reveal anything sensitive on its own.
PUBLIC_API_KEY=replace-with-a-public-safe-value

# --- Google OAuth (client login) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- MTN MoMo (sandbox first, then production) ---
MTN_MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MTN_MOMO_SUBSCRIPTION_KEY=
MTN_MOMO_API_USER=
MTN_MOMO_API_KEY=
MTN_MOMO_TARGET_ENVIRONMENT=sandbox

# --- Airtel Money (staging first, then production) ---
AIRTEL_BASE_URL=https://openapiuat.airtel.africa
AIRTEL_CLIENT_ID=
AIRTEL_CLIENT_SECRET=

# --- M-Pesa Daraja (sandbox first, then production) ---
MPESA_BASE_URL=https://sandbox.safaricom.co.ke
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://your-domain.example.com/api/payments/mpesa/callback

# --- SMS/WhatsApp notification provider (fill in whichever you choose) ---
SMS_PROVIDER_API_KEY=
